# ──────────────────────────────────────────────
# ChatAGI Adu Backend — environment template
# Copy to `.env` and fill in your own values.
# NEVER commit a real .env. All values below are placeholders only.
# ──────────────────────────────────────────────

# ---- App ----
APP_ENV=development
PORT=8000

# ---- LLM providers ----
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_CHAT_MODEL=
OPENAI_REALTIME_SESSIONS_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Optional additional providers
CODEX_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=

# ---- Local computer-control agent ----
LOCAL_AGENT_BASE_URL=http://127.0.0.1:4317
LOCAL_AGENT_TOKEN=
AI_BRAIN_LOCAL_AGENT_BASE_URL=http://127.0.0.1:4317
AI_BRAIN_LOCAL_AGENT_TOKEN=
COMPUTER_AGENT_TOKEN=

# ---- Auth / sessions ----
JWT_SECRET=
JWT_TTL_SEC=86400
CHATAGI_JWT_SECRET=
CHATAGI_JWT_TTL_SECONDS=86400

# ---- Database / persistence ----
DATABASE_URL=
BILLING_DATABASE_URL=

# ---- Billing (App Store / entitlements) ----
BILLING_ENABLED=false
APPLE_BUNDLE_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY=

# ---- Realtime voice (WebRTC TURN) ----
CHATAGI_TURN_URLS=
CHATAGI_TURN_USERNAME=
CHATAGI_TURN_CREDENTIAL=

# ---- Realtime voice (LiveKit WebRTC) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=adu-three-stage-agent
LIVEKIT_AUTO_DISPATCH_AGENT=1
LIVEKIT_TOKEN_TTL_S=3600
ADU_REALTIME_MODEL=adu-three-stage-v2
ADU_OUTPUT_SAMPLE_RATE=24000
ALIYUN_TTS_AUDIO_FORMAT=pcm

# ---- Optional bridge / local screen stream (set explicitly) ----
OPENCLAW_BRIDGE_TOKEN=
BACKEND_WS_URL=ws://127.0.0.1:8000
ADU_USER_KEY=

# ---- Optional Polar webhook ----
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO=
POLAR_PRODUCT_ID_ULTRA=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_TOLERANCE_S=300

# --- 危险接口鉴权（agent_guard）---
# 受保护接口要求请求头 X-Agent-Token 与这里一致；不设置则只有本机、无 Origin 的请求能访问
AGENT_API_TOKEN=
# 1 = 本机（127.0.0.1 / ::1）、无 Origin、无代理转发头的请求可以不带令牌
ADU_AGENT_TRUST_LOOPBACK=1
# 追加到公开白名单的精确路径 / 路径前缀（逗号分隔，留空用内置白名单）
ADU_PUBLIC_EXACT=
ADU_PUBLIC_PREFIXES=
